<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0D0D"
    android:padding="32dp">

    <!-- Lock icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"
        android:layout_marginBottom="24dp" />

    <!-- App name -->
    <TextView
        android:id="@+id/tv_blocked_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This App"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Reason -->
    <TextView
        android:id="@+id/tv_blocked_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app has been blocked by your parent."
        android:textColor="#888888"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="48dp" />

    <!-- Souls branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◈ SOULS"
        android:textColor="#A07CFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parental Controls Active"
        android:textColor="#444444"
        android:textSize="12sp"
        android:layout_marginBottom="64dp" />

    <!-- Parent unlock button -->
    <Button
        android:id="@+id/btn_enter_pin"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Parent unlock"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_action_card"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:textSize="14sp" />

    <!-- PIN entry section (hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_pin_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_parent_pin"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:hint="Enter PIN"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="@drawable/bg_action_card"
            android:gravity="center"
            android:inputType="numberPassword"
            android:textSize="22sp"
            android:padding="12dp"
            android:letterSpacing="0.3"
            android:maxLength="8" />

        <Button
            android:id="@+id/btn_confirm_pin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Unlock"
            android:textColor="#0D0D0D"
            android:backgroundTint="#A07CFF"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Unlock options (shown after correct PIN) -->
    <LinearLayout
        android:id="@+id/layout_unlock_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIN correct. What would you like to do?"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_allow_once"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Allow for 1 hour"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_action_card"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_unblock_permanent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Unblock permanently"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A07CFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_cancel_unlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="#888888"
            android:backgroundTint="#1C1C1E"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>