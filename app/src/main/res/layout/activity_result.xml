<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/bg_dark">

    <!-- Result icon (check or error) -->
    <ImageView
        android:id="@+id/iv_result_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_check_circle"
        android:layout_marginBottom="24dp" />

    <!-- Result title: "Verified ✓" or "Verification Failed" -->
    <TextView
        android:id="@+id/tv_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verified ✓"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/green"
        android:layout_marginBottom="12dp" />

    <!-- Session ID -->
    <TextView
        android:id="@+id/tv_session_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session: —"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp" />

    <!-- Message from server -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="0dp"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/tv_result_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="User verified. The Souls app will now finalize registration."
            android:textSize="15sp"
            android:textColor="@color/white"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center" />

    </androidx.cardview.widget.CardView>

    <!-- Action button: "New Scan" or "Try Again" -->
    <Button
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="New Scan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent"
        android:textColor="@color/white" />

</LinearLayout>