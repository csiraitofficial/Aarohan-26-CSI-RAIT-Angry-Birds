<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top bar -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="24dp">
            <ImageView android:id="@+id/iv_back" android:layout_width="40dp"
                android:layout_height="40dp" android:layout_gravity="center_vertical|start"
                android:padding="8dp" android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="Soul Identity"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>

        <!-- Progress -->
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" android:visibility="gone" />

        <!-- Error -->
        <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_badge" android:padding="12dp"
            android:textColor="#FF5555" android:textSize="13sp" android:visibility="gone" />

        <!-- Soul ID highlight card (tappable → copies) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:background="@drawable/bg_action_card"
            android:orientation="vertical" android:padding="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" android:text="SOUL ID"
                        android:textColor="#A07CFF" android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.12" />
                    <TextView android:id="@+id/tv_soul_id_full" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="monospace"
                        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Copy hint -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="tap to copy" android:textColor="#555555" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tap-to-copy hint -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="All fields below are tappable — tap any value to copy it."
            android:textColor="#555555" android:textSize="11sp" android:gravity="end" />

        <!-- SOUL HASH -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="SOUL HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_soul_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- BLOCK HASH -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="BLOCK HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_block_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- PREVIOUS HASH -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="PREVIOUS HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_previous_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- CHAIN POSITION -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="CHAIN POSITION"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_block_index" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- NONCE -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="NONCE"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_block_nonce" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="monospace" />

        <!-- DEVICE KEY -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="DEVICE KEY"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_device_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- REGISTERED VIA LAMP -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="REGISTERED VIA LAMP"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_lamp_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- FINGERPRINT VERIFIED -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="FINGERPRINT VERIFIED"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_verified_at" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- BLOCK MINED -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="BLOCK MINED"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_timestamp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- FINGERPRINT HASH -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="FINGERPRINT HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_fingerprint_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- REGISTRATION SESSION -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="REGISTRATION SESSION"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_reg_session_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="28dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="12sp" android:fontFamily="monospace" />

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#2A2A2A" android:layout_marginBottom="20dp" />

        <!-- Export PDF Certificate button -->
        <Button
            android:id="@+id/btn_export_pdf"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="⬇  Export Identity Certificate (PDF)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Subtext under button -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="Generates a signed PDF you can save, print, or share as proof of identity."
            android:textColor="#555555"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>