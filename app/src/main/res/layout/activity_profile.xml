<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Name -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="NAME"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="16sp" />

        <!-- Soul ID -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="SOUL ID"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_soul_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#A07CFF" android:textSize="15sp" android:fontFamily="monospace" />

        <!-- Soul Hash -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="SOUL HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_soul_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="13sp" android:fontFamily="monospace" />

        <!-- Block Hash -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="BLOCK HASH"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_block_hash" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="13sp" android:fontFamily="monospace" />

        <!-- Block Index -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="BLOCK INDEX"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_block_index" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- Verified At -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="VERIFIED AT"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_verified_at" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />

        <!-- Device Key -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="DEVICE KEY"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_device_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#CCCCCC" android:textSize="13sp" android:fontFamily="monospace" />

        <!-- LAMP ID -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" android:text="LAMP ID"
            android:textColor="#888888" android:textSize="11sp" android:letterSpacing="0.1" />
        <TextView android:id="@+id/tv_lamp_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:background="@drawable/bg_action_card" android:padding="14dp"
            android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>