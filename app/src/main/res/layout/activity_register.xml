<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Icon -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_orb"
        android:contentDescription="Soul icon" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="Almost There"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:text="Your fingerprint has been verified.\nEnter your name to mint your Soul."
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Name field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Your Name"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_edittext"
        android:hint="e.g. Alex Johnson"
        android:textColorHint="#555555"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Error -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="#FF5555"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Finalize button -->
    <Button
        android:id="@+id/btn_finalize"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:text="Mint My Soul"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>