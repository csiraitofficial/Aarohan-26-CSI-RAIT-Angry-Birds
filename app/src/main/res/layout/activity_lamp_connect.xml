<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Back arrow -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow" />
    </FrameLayout>

    <!-- Fingerprint icon — fades in/out via alpha in code -->
    <ImageView
        android:id="@+id/iv_fingerprint"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        android:alpha="0.3"
        android:contentDescription="Fingerprint"
        android:src="@drawable/ic_fingerprint" />

    <!-- Status heading -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Find a LAMP Device"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:text="Scan for a nearby LAMP device to begin identity registration"
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Error message -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_status_badge"
        android:padding="12dp"
        android:textColor="#FF5555"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Progress spinner -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

    <!-- Scan button -->
    <Button
        android:id="@+id/btn_scan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_button_primary"
        android:text="Scan for LAMP"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Retry button -->
    <Button
        android:id="@+id/btn_retry"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Try Again"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>