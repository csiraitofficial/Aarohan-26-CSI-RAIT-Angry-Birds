<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawable for the red "BLOCKED" badge shown next to app names in the
    usage report. Place in res/drawable/bg_badge_blocked.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FF5555" />
    <stroke android:width="1dp" android:color="#FF5555" />
    <corners android:radius="4dp" />
</shape>